# ── Python / FastAPI ────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.so

# Entornos virtuales
backend-fastapi/.venv/
backend-fastapi/venv/
backend-fastapi/env/

# Variables de entorno (contienen credenciales)
backend-fastapi/.env

# Artefactos de distribución / build
backend-fastapi/dist/
backend-fastapi/build/
backend-fastapi/*.egg-info/

# Testing / coverage
.pytest_cache/
.coverage
htmlcov/

# Type checkers
.mypy_cache/
.ruff_cache/

# ── Next.js / Node ──────────────────────────────────────────────────────────
frontend-nextjs/.next/
frontend-nextjs/out/
frontend-nextjs/node_modules/
frontend-nextjs/.vercel/
frontend-nextjs/next-env.d.ts
frontend-nextjs/*.tsbuildinfo
frontend-nextjs/.env*
frontend-nextjs/*.pem
frontend-nextjs/.pnp
frontend-nextjs/.pnp.*
frontend-nextjs/.yarn/*
!frontend-nextjs/.yarn/patches
!frontend-nextjs/.yarn/plugins
!frontend-nextjs/.yarn/releases
!frontend-nextjs/.yarn/versions

# Logs Node
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ── Editores / SO ───────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo
